rules_version = '2';

// Clients READ Firestore directly (live listeners) but never WRITE it: every write goes through
// a Cloud Function, which uses the Admin SDK (bypasses these rules) and is where authorization
// and usage logging live. Rules are per-document, never per-field, so anything with a different
// audience lives in its own document (email in players/{uid}/private, invite code in
// tournaments/{id}/private). The top-level inviteCodes/** collection is intentionally unmatched
// below: no client may touch it, only the join function (Admin SDK).
//
// Tournament docs always carry visibility ('private' | 'public') and status ('active' |
// 'suspended'); createTournament sets both. status/visibility are read with .get(..., default) so
// a missing field fails closed instead of erroring the whole expression.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function me() {
      return request.auth.uid;
    }

    function tournamentOf(tid) {
      return get(/databases/$(database)/documents/tournaments/$(tid)).data;
    }

    function isAdmin(tid) {
      return tournamentOf(tid).get('organizerId', null) == me()
          || tournamentOf(tid).get('coAdminId', null) == me();
    }

    function isMember(tid) {
      return exists(/databases/$(database)/documents/tournaments/$(tid)/players/$(me()));
    }

    function isActive(tid) {
      return tournamentOf(tid).get('status', 'suspended') == 'active';
    }

    function isPublic(tid) {
      return tournamentOf(tid).get('visibility', 'private') == 'public';
    }

    // Everything under a tournament except private/*: admins always; others only while the
    // tournament is active, and only if it is public (spectating) or they are on the roster.
    function canView(tid) {
      return signedIn() && (isAdmin(tid) || (isActive(tid) && (isPublic(tid) || isMember(tid))));
    }

    // Invite code and other settings: admins, and roster members of an active tournament.
    // Spectators of a public tournament never see these.
    function canViewPrivate(tid) {
      return signedIn() && (isAdmin(tid) || (isActive(tid) && isMember(tid)));
    }

    match /players/{playerId} {
      allow read: if signedIn();
      allow write: if false;

      match /private/{docId} {
        allow read: if signedIn() && me() == playerId;
        allow write: if false;
      }
    }

    // "My tournaments": a collection-group query on roster entries filtered by playerId. Each
    // roster entry carries the player's uid, so a player can list (and read) only their own
    // entries, in any tournament, including a suspended one (so the app can say it is suspended
    // instead of the tournament silently vanishing). The entry holds only that player's own
    // team and handicap. Reading the tournament itself is still governed by the rules below.
    // This also matches top-level players/{uid} profile docs, which have no playerId field, so
    // it never grants them.
    match /{path=**}/players/{entryId} {
      allow read: if signedIn() && resource.data.get('playerId', null) == me();
    }

    match /tournaments/{tid} {
      // The tournament document itself is read via resource.data (no extra get()).
      allow read: if signedIn() && (
        resource.data.get('organizerId', null) == me()
        || resource.data.get('coAdminId', null) == me()
        || (resource.data.get('status', 'suspended') == 'active'
            && (resource.data.get('visibility', 'private') == 'public' || isMember(tid)))
      );
      allow write: if false;

      match /players/{pid} {
        allow read: if canView(tid);
        allow write: if false;
      }

      match /teams/{teamId} {
        allow read: if canView(tid);
        allow write: if false;
      }

      match /private/{docId} {
        allow read: if canViewPrivate(tid);
        allow write: if false;
      }

      // Rounds and their groups (who plays together, and when). Spectators of a public tournament see
      // them too, so nothing private may ever be stored in these documents. Everything else that will
      // live under a round and is not matched below (disputes, cards, standings) is deliberately NOT matched
      // here: it stays denied until its own rule and tests are added with the step that creates it.
      match /rounds/{roundId} {
        allow read: if canView(tid);
        allow write: if false;

        match /groups/{groupId} {
          allow read: if canView(tid);
          allow write: if false;
        }

        // The score inbox. A phone writes a submission (through Firestore's offline queue); a function checks it
        // and writes the official score, or marks the submission rejected with a reason the phone shows. Clients
        // can only CREATE one, and only with exactly these fields: the outcome fields (outcome, reason,
        // processedAt) are written by the function alone. The document id is fixed by the content
        // (player_hole_time), so a retried write is the same document and never a duplicate. The only lookup is
        // roster membership (it keeps strangers out of a tournament they could otherwise run up cost in); the
        // round's real checks (group, hole range, maximum score, lock) are the function's job. A person reads
        // their own submissions (to see a rejection); admins read all of them.
        match /submissions/{submissionId} {
          allow read: if signedIn() && (isAdmin(tid) || resource.data.get('enteredBy', null) == me());
          allow create: if signedIn() && isMember(tid)
            && request.resource.data.keys().hasOnly(['playerId', 'hole', 'strokes', 'kind', 'groupId', 'enteredBy', 'clientTime'])
            && request.resource.data.keys().hasAll(['playerId', 'hole', 'strokes', 'kind', 'groupId', 'enteredBy', 'clientTime'])
            && request.resource.data.enteredBy == me()
            && request.resource.data.playerId is string
            && request.resource.data.playerId.size() >= 1 && request.resource.data.playerId.size() <= 64
            && request.resource.data.groupId is string
            && request.resource.data.groupId.size() >= 1 && request.resource.data.groupId.size() <= 64
            && request.resource.data.hole is int
            && request.resource.data.hole >= 1 && request.resource.data.hole <= 18
            && request.resource.data.strokes is int
            && request.resource.data.strokes >= 1 && request.resource.data.strokes <= 30
            && request.resource.data.kind in ['played', 'pickup']
            && request.resource.data.clientTime is int
            && request.resource.data.clientTime > 0
            && submissionId == request.resource.data.playerId + '_' + string(request.resource.data.hole)
                               + '_' + string(request.resource.data.clientTime);
          allow update, delete: if false;
        }

        // The official score entries, written only by the function. Roster members and admins read them;
        // spectators see the derived cards and standings instead, never the raw entries.
        match /scores/{scoreId} {
          allow read: if canViewPrivate(tid);
          allow write: if false;
        }
      }

      // The activity feed (announcements and audit trail). Admins read all of it. A roster member
      // of an active tournament reads events at level 'all', plus events at level 'affected' that
      // are about them. Rules do not filter, they only allow or deny a whole query, so a member
      // must ask with the matching filters: where level == 'all', and separately where
      // level == 'affected' and targetPlayerId == their uid. Spectators never see the feed.
      match /activity/{eventId} {
        allow read: if signedIn() && (
          isAdmin(tid)
          || (isActive(tid) && isMember(tid)
              && (resource.data.get('level', 'admins') == 'all'
                  || (resource.data.get('level', 'admins') == 'affected'
                      && resource.data.get('targetPlayerId', null) == me())))
        );
        allow write: if false;
      }
    }
  }
}
