{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": ["node_modules", ".git", "firebase-debug.log", "firebase-debug.*.log", "*.local"]
    }
  ],
  "emulators": {
    "auth": { "port": 9199 },
    "functions": { "port": 5101 },
    "firestore": { "port": 8181 },
    "hub": { "port": 4401 },
    "logging": { "port": 4501 },
    "ui": { "enabled": false }
  }
}
