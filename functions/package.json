{
  "name": "functions",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run --exclude \"**/*.emulated.test.ts\"",
    "test:rules": "firebase emulators:exec --config ../firebase.test.json --only firestore --project demo-golf-rules \"vitest run rules.emulated\"",
    "test:emulated": "firebase emulators:exec --config ../firebase.test.json --only firestore --project demo-golf-rules \"vitest run .emulated.\""
  },
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^22.20.5",
    "firebase": "^12.19.0",
    "firebase-tools": "^15.34.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
